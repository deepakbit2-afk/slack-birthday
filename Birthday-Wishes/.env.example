# ─────────────────────────────────────────────
# .env  —  LOCAL DEVELOPMENT SECRETS
# Do NOT commit this file to version control!
# ─────────────────────────────────────────────

# Slack Incoming Webhook URL
# How to get it:
#   1. Go to https://api.slack.com/apps
#   2. Create a new App → "From scratch"
#   3. Enable "Incoming Webhooks"
#   4. Add New Webhook to Workspace → select channel
#   5. Copy the Webhook URL and paste it below
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Path to the employees CSV (default is data/employees.csv relative to project root)
# Leave blank to use the default path
CSV_PATH=
